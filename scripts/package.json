{
  "name": "emoji-styles-scripts",
  "private": true,
  "type": "module",
  "scripts": {
    "benchmark:emoji-quality": "node --import tsx benchmark-emoji-quality.ts",
    "benchmark:emoji-visual": "node --import tsx render-emoji-benchmark.ts",
    "generate": "tsx generate-emoji-data.ts",
    "generate:check": "tsx generate-emoji-data.ts --check",
    "generate:validate": "tsx generate-emoji-data.ts --check",
    "generate:all": "tsx generate-emoji-data.ts",
    "generate:fluent-animated": "tsx generate-fluent-animated-index.ts",
    "generate:serenityos": "tsx generate-serenityos-index.ts",
    "assets:check": "tsx sync-open-assets.ts --dry-run",
    "assets:sync": "tsx sync-open-assets.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "benchmark:catalog": "node --import tsx benchmark-catalog.ts",
    "benchmark:visual-plan": "node --import tsx prepare-visual-study.ts",
    "benchmark:visual-review": "node --import tsx export-visual-review.ts"
  },
  "devDependencies": {
    "@types/node": "22.15.0",
    "playwright": "1.64.1",
    "tsx": "^4.19.0",
    "typescript": "5.9.3",
    "vitest": "2.1.9"
  },
  "dependencies": {
    "sharp": "0.34.3"
  }
}
