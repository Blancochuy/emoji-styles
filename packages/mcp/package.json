{
  "name": "emoji-styles-mcp",
  "version": "0.1.0",
  "description": "Local MCP server for deterministic emoji resolution, auditing, semantic analysis, and custom provider tooling",
  "engines": {
    "node": "^18.17.0 || ^20.3.0 || >=21.0.0"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "emoji-styles-mcp": "./dist/stdio.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "emoji-styles": "workspace:*",
    "emoji-styles-cli": "workspace:*",
    "zod": "4.4.3",
    "sharp": "0.34.3"
  },
  "devDependencies": {
    "@types/node": "22.15.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.9",
    "@emoji-styles/asset-pipeline": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Blancochuy/emoji-styles.git",
    "directory": "packages/mcp"
  },
  "keywords": [
    "emoji",
    "mcp",
    "model-context-protocol",
    "developer-tools",
    "ai-agents"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "homepage": "https://emoji-styles.space",
  "bugs": {
    "url": "https://github.com/Blancochuy/emoji-styles/issues"
  }
}
