{
  "name": "emoji-styles-cli",
  "version": "0.3.1",
  "description": "Deterministic emoji auditing, codemods, project validation, asset sync, and provider tooling",
  "engines": {
    "node": "^18.17.0 || ^20.3.0 || >=21.0.0"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "emoji-styles": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./audit": {
      "types": "./dist/audit-entry.d.ts",
      "import": "./dist/audit-entry.js"
    },
    "./schema/config": "./schemas/emoji-styles-config.schema.json"
  },
  "files": [
    "dist",
    "schemas"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@babel/parser": "7.29.7",
    "emoji-styles": "workspace:^",
    "parse5": "7.3.0",
    "sharp": "0.34.3"
  },
  "devDependencies": {
    "@types/node": "22.15.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.9",
    "@emoji-styles/asset-pipeline": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Blancochuy/emoji-styles.git",
    "directory": "packages/cli"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "homepage": "https://emoji-styles.space",
  "bugs": {
    "url": "https://github.com/Blancochuy/emoji-styles/issues"
  },
  "keywords": [
    "emoji",
    "cli",
    "tui",
    "image-processing",
    "ai-agents"
  ]
}
